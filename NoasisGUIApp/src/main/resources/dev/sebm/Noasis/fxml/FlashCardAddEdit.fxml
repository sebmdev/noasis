<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<StackPane xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.sebm.noasis.controller.FlashCardAddEditController">
   <children>
      <VBox fx:id="content">
         <children>
            <Label prefHeight="18.0" prefWidth="101.0" text="Term">
               <font>
                  <Font name="Georgia" size="17.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>
            <TextArea fx:id="taTerm" prefHeight="54.0" prefWidth="890.0">
               <VBox.margin>
                  <Insets bottom="20.0" />
               </VBox.margin>
            </TextArea>
            <Label prefHeight="18.0" prefWidth="101.0" text="Definition">
               <font>
                  <Font name="Georgia" size="17.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="10.0" />
               </VBox.margin>
            </Label>
            <TextArea fx:id="taDefinition" prefHeight="215.0" prefWidth="890.0" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
               <children>
                  <Button fx:id="btnSave" mnemonicParsing="false" styleClass="accent" text="Save">
                     <font>
                        <Font name="Georgia" size="15.0" />
                     </font>
                  </Button>
                  <Button fx:id="btnCancel" mnemonicParsing="false" text="Cancel">
                     <font>
                        <Font name="Georgia" size="15.0" />
                     </font>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets top="10.0" />
               </VBox.margin>
            </HBox>
         </children>
         <padding>
            <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
         </padding>
      </VBox>
      <ProgressIndicator fx:id="progressIndicator" StackPane.alignment="CENTER" />
   </children>
</StackPane>
