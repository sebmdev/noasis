<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="200.0" prefWidth="1000.0" xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.sebm.noasis.controller.FlashCardsController">
   <children>
      <StackPane prefHeight="650.0" prefWidth="1080.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <AnchorPane fx:id="content" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308">
               <children>
                  <HBox alignment="CENTER_LEFT" prefHeight="50.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                     <children>
                        <Button fx:id="btnBack" mnemonicParsing="false" style="-fx-underline: false;" styleClass="flat" text="Study Sets">
                           <graphic>
                              <FontIcon iconLiteral="fa-angle-left" />
                           </graphic>
                           <cursor>
                              <Cursor fx:constant="HAND" />
                           </cursor>
                        </Button>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="10.0">
                           <children>
                              <Button contentDisplay="GRAPHIC_ONLY">
                                 <font>
                                    <Font name="Georgia" size="15.0" />
                                 </font>
                                 <graphic>
                                    <FontIcon iconLiteral="fa-share" />
                                 </graphic>
                              </Button>
                              <Button prefHeight="29.0" prefWidth="135.0" text="Take mock quiz">
                                 <font>
                                    <Font name="Georgia" size="15.0" />
                                 </font>
                              </Button>
                              <Button fx:id="btnAddCard" styleClass="accent" text="Add Card">
                                 <font>
                                    <Font name="Georgia" size="15.0" />
                                 </font>
                              </Button>
                           </children>
                        </HBox>
                     </children>
                     <padding>
                        <Insets left="20.0" right="20.0" />
                     </padding>
                  </HBox>
                  <AnchorPane layoutX="-2.0" layoutY="48.0" prefHeight="600.0" prefWidth="1080.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="50.0">
                     <children>
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" layoutY="88.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                           <content>
                              <TilePane fx:id="tilePane" hgap="50.0" prefColumns="1" prefRows="20" tileAlignment="TOP_LEFT" vgap="50.0">
                                 <padding>
                                    <Insets left="30.0" right="30.0" top="30.0" />
                                 </padding>
                              </TilePane>
                           </content>
                        </ScrollPane>
                     </children>
                  </AnchorPane>
               </children>
            </AnchorPane>
            <ProgressIndicator fx:id="progressIndicator" mouseTransparent="true" />
         </children>
      </StackPane>
   </children>
</AnchorPane>
