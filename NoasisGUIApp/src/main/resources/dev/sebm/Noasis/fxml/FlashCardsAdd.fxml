<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox xmlns="http://javafx.com/javafx/22" xmlns:fx="http://javafx.com/fxml/1">
   <children>
      <Label prefHeight="18.0" prefWidth="101.0" text="Term">
         <font>
            <Font name="Georgia" size="17.0" />
         </font>
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
      </Label>
      <TextArea prefHeight="54.0" prefWidth="890.0">
         <VBox.margin>
            <Insets bottom="20.0" />
         </VBox.margin></TextArea>
      <Label prefHeight="18.0" prefWidth="101.0" text="Definition">
         <font>
            <Font name="Georgia" size="17.0" />
         </font>
         <VBox.margin>
            <Insets bottom="10.0" />
         </VBox.margin>
      </Label>
      <TextArea prefHeight="215.0" prefWidth="890.0" />
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button mnemonicParsing="false" styleClass="success" text="Save">
               <font>
                  <Font name="Georgia" size="15.0" />
               </font>
            </Button>
            <Button mnemonicParsing="false" styleClass="danger" text="Cancel">
               <font>
                  <Font name="Georgia" size="15.0" />
               </font>
            </Button>
         </children>
         <VBox.margin>
            <Insets top="10.0" />
         </VBox.margin>
      </HBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</VBox>
